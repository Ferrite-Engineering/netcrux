# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Flutter gen-l10n output (regenerated on build)
lib/l10n/generated/
lib/generated/

# Riverpod / build_runner generated files (regenerated on build)
**/*.g.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Per-project NetCrux Pro runtime artifacts. Pro features (custom cell
# symbols, bookmarks, annotations, …) write into directories sibling
# to the user's project file (e.g. `<project>/.netcrux-symbols/`). The
# rule lives in the open-core repo because fixture projects under
# `test/fixtures/project/` are accessed in CI; Pro tests can create
# these dirs at any time and they must not be committed.
**/.netcrux/
**/.netcrux-symbols/
**/.netcrux-bookmarks.json
**/.netcrux-annotations.json

# Dart & Flutter DevTools local settings (per-developer, regenerated on demand)
devtools_options.yaml

# pubspec.lock IS tracked (2026-08-14). It was excluded as "path-dep version
# churn noise", and the cost of that showed up as CI going red on a commit that
# touched none of the affected code: CI resolves fresh every run, so
# `file_picker` publishing 12.0.0 broke the build while every local checkout
# kept passing from an older resolution. This is an application, not a library
# — the lock is the record of what was actually built and tested.

# Cloudflare Wrangler local cache (deploy_web.sh)
.wrangler/

# mkdocs build output. Generated by `mkdocs build` from docs-site/docs/; the
# published site is deployed from CI, never from a commit. 61 of these files
# were tracked in simcrux until the open-core flip audit found them.
docs-site/site/

# Local environment files. None of these exist today, and none should: a
# public repo with outside contributors is where one gets committed by
# accident, and a secret in git history outlives its deletion.
.env
.env.*
!.env.example
# Two more spellings the `.env` rules above do not cover: Wrangler reads
# local secrets from `.dev.vars`, and direnv from `.envrc`. Both are files a
# contributor creates on their own machine, which is exactly how one gets
# committed.
.dev.vars
.dev.vars.*
.envrc

# Rust build output of the native layout engine and its vendored crate.
native/**/target/
